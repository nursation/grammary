{
  "manifest_version": 3,
  "name": "Grammary",
  "version": "0.2.0",
  "description": "Wand and EN/RU buttons on every textarea: fix grammar or translate with local Claude via the grammary server on 127.0.0.1.",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["http://127.0.0.1:8917/*"]
}
